  {
   "cell_type": "code",
   "outputs": [],
   "source": [
    "# Implement the Discriminator and the generator :\n",
    "class Discriminator(nn.Module):\n",
    "    def __init__(self):\n",
    "        super().__init__()\n",
    "        self.model = nn.Sequential(\n",
    "            nn.Linear(3*360*360, 1024), #RGB image\n",
    "            nn.ReLU(),\n",
    "            nn.Dropout(0.3),\n",
    "            nn.Linear(1024, 512),\n",
    "            nn.ReLU(),\n",
    "            nn.Dropout(0.3),\n",
    "            nn.Linear(512, 256),\n",
    "            nn.ReLU(),\n",
    "            nn.Dropout(0.3),\n",
    "            nn.Linear(256, 1),\n",
    "            nn.Sigmoid(),\n",
    "        )\n",
    "\n",
    "    def forward(self, x): # x is the input image, the vectorization occurs in the first line of .forward(), as the call to x.view() converts the shape of the input tensor (x is 8 x 1 x 360 x 360), where 8 is the batch size that we've set up first. AFter the conversion, the share of x becomes 8 x 360*360.\n",
    "        x = x.view(x.size(0), 3*360*360) #RGB image\n",
    "        output = self.model(x)\n",
    "        return output"
   ],
   "metadata": {
    "collapsed": false,
    "ExecuteTime": {
     "end_time": "2024-03-20T13:29:00.891350400Z",
     "start_time": "2024-03-20T13:29:00.884399Z"
    }
   },
   "id": "c9d11eacafca4da4",
   "execution_count": 190
  },
  {
   "cell_type": "code",
   "outputs": [],
   "source": [
    "# we send the model to our \"device\" \n",
    "discriminator = Discriminator().to(device=device)"
   ],
   "metadata": {
    "collapsed": false,
    "ExecuteTime": {
     "end_time": "2024-03-20T13:29:05.628503600Z",
