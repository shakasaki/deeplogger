    "\n",
    "# here we define our Generator : \n",
    "class Generator(nn.Module):\n",
    "    def __init__(self):\n",
    "        super().__init__()\n",
    "        self.model = nn.Sequential(\n",
    "            nn.Linear(200, 256),\n",
    "            nn.ReLU(),\n",
    "            nn.Linear(256, 512),\n",
    "            nn.ReLU(),\n",
    "            nn.Linear(512, 1024),\n",
    "            nn.ReLU(),\n",
    "            nn.Linear(1024, 1 * 360 * 360),\n",
    "            nn.Tanh(),\n",
    "            #the output function is tahn (hyperbolic tangen function), as the activation of the output coefficiebts should be in an interval from -1 to 1 (because we normalized our dataset above).\n",
    "        )\n",
    "\n",
    "    def forward(self, x):\n",
    "        output = self.model(x)\n",
    "        output = output.view(x.size(0), 1, 360, 360)\n",
    "        return output\n",
    "\n",
    "\n",
    "generator = Generator().to(device=device)\n"
   ],
