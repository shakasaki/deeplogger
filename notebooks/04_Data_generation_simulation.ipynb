   "cell_type": "code",
   "outputs": [],
   "source": [
    "# Implement the Discriminator and the generator :\n",
    "class Discriminator(nn.Module):\n",
    "    def __init__(self):\n",
    "        super().__init__()\n",
    "        self.model = nn.Sequential(\n",
    "            nn.Linear(784, 1024),\n",
    "            nn.ReLU(),\n",
    "            nn.Dropout(0.3),\n",
    "            nn.Linear(1024, 512),\n",
    "            nn.ReLU(),\n",
    "            nn.Dropout(0.3),\n",
    "            nn.Linear(512, 256),\n",
    "            nn.ReLU(),\n",
    "            nn.Dropout(0.3),\n",
    "            nn.Linear(256, 1),\n",
    "            nn.Sigmoid(),\n",
    "        )\n",
    "\n",
    "    def forward(self, x): # x is the input image, the vectorization occurs in the first line of .forward(), as the call to x.view() converts the shape of the input tensor (x is 32 x 1 x 28 x 28), where 32 is the batch size that we've set up first. AFter the conversion, the share of x becomes 32 x 784.\n",
    "        x = x.view(x.size(0), 784)\n",
    "        output = self.model(x)\n",
    "        return output"
   ],
   "metadata": {
    "collapsed": false,
    "ExecuteTime": {
     "end_time": "2024-03-12T14:48:01.939109200Z",
     "start_time": "2024-03-12T14:48:01.932359300Z"
    }
   },
   "id": "3245f794d6648ac7",
   "execution_count": 11
  },
  {
   "cell_type": "code",
   "outputs": [],
   "source": [
    "# we send the model to our \"device\" \n",
    "discriminator = Discriminator().to(device=device)"
   ],
   "metadata": {
    "collapsed": false,
    "ExecuteTime": {
     "end_time": "2024-03-12T14:48:12.551487600Z",
     "start_time": "2024-03-12T14:48:12.527338100Z"
    }
   },
   "id": "3ffff60ea4e53cb6",
   "execution_count": 12
  },
  {
   "cell_type": "code",
   "outputs": [],
   "source": [
    "# here we define our Generator : \n",
    "class Generator(nn.Module):\n",
    "    def __init__(self):\n",
    "        super().__init__()\n",
    "        self.model = nn.Sequential(\n",
    "            nn.Linear(100, 256),\n",
    "            nn.ReLU(),\n",
    "            nn.Linear(256, 512),\n",
    "            nn.ReLU(),\n",
    "            nn.Linear(512, 1024),\n",
    "            nn.ReLU(),\n",
    "            nn.Linear(1024, 784),\n",
    "            nn.Tanh(), #the output function is tahn (hyperbolic tangen function), as the activation of the output coefficiebts should be in an interval from -1 to 1 (because we normalized our dataset above).\n",
    "        )\n",
    "\n",
    "    def forward(self, x):\n",
    "        output = self.model(x)\n",
    "        output = output.view(x.size(0), 1, 28, 28)\n",
    "        return output\n",
    "\n",
    "generator = Generator().to(device=device)"
   ],
   "metadata": {
    "collapsed": false,
    "ExecuteTime": {
     "end_time": "2024-03-12T14:51:36.160238500Z",
     "start_time": "2024-03-12T14:51:36.150780200Z"
    }
   },
