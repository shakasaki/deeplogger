    "# change the discriminator to fit a 3 channel RGB image\n",
    "\n",
    "\n",
    "\n"
   ],
   "metadata": {
    "collapsed": false,
    "ExecuteTime": {
     "end_time": "2024-03-20T13:06:27.328516400Z",
